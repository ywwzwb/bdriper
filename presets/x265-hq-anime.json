{
  "name": "x265 HQ Anime",
  "encoder": "x265",
  "mode": "cpu",
  "description": "高质量动漫 BDRip 压制。CRF=15, 关闭 SAO, AQ mode=1。适合 1080p 蓝光源。",
  "params": {
    "crf": 15.0,
    "preset": "slower",
    "deblock": "-1:-1",
    "ctu": 32,
    "qg-size": 8,
    "me": "star",
    "subme": 5,
    "merange": 38,
    "bframes": 6,
    "ref": 4,
    "weightb": true,
    "b-intra": true,
    "qcomp": 0.65,
    "aq-mode": 1,
    "aq-strength": 0.8,
    "no-sao": true,
    "rc-lookahead": 80,
    "psy-rd": 2.0,
    "psy-rdoq": 1.0,
    "rdoq-level": 2,
    "rd": 5,
    "pbratio": 1.2,
    "cbqpoffs": -2,
    "crqpoffs": -2,
    "colormatrix": "bt709",
    "no-open-gop": true,
    "keyint": 360,
    "min-keyint": 1,
    "no-strong-intra-smoothing": true,
    "limit-tu": 4,
    "no-amp": true
  }
}
